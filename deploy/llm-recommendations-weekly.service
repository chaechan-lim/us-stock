[Unit]
Description=LLM-driven AgentRecommendation generator (weekly)
After=usstock-backend.service

[Service]
Type=oneshot
User=chans
WorkingDirectory=/home/chans/us-stock
EnvironmentFile=/home/chans/us-stock/.env
ExecStart=/home/chans/us-stock/venv/bin/python scripts/generate_recommendations.py --mode weekly
StandardOutput=journal
StandardError=journal
