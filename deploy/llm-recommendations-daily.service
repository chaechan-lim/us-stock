[Unit]
Description=LLM-driven AgentRecommendation generator (daily)
After=usstock-backend.service daily-post-market-analysis.service
Wants=daily-post-market-analysis.service

[Service]
Type=oneshot
User=chans
WorkingDirectory=/home/chans/us-stock
EnvironmentFile=/home/chans/us-stock/.env
ExecStart=/home/chans/us-stock/venv/bin/python scripts/generate_recommendations.py --mode daily
StandardOutput=journal
StandardError=journal
